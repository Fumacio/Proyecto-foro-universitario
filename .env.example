# Copiá este archivo a server/.env (npm run setup lo crea solo si no existe)
PORT=3000
NODE_ENV=development
# Origen del front (dev: Vite en 5173; prod: el mismo server)
FRONTEND_URL=http://localhost:5173
DATABASE_URL="file:./dev.db"
# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme-generate-a-strong-random-secret

# Email (opcional). Sin SMTP, el link de recuperación se imprime en la consola del server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Foro UTN <no-reply@foro.utn>"

# TRUST_PROXY=1   # detrás de un proxy (Render, Railway, Nginx)
